# Copy this file to `.env` (next to manage.py) and fill it in. Never commit the real .env file.
# With no .env at all the site runs in development mode on your computer.

# --- required on a live server ---
DEBUG=false
# A long random string, e.g. run: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Your domain names, comma-separated
ALLOWED_HOSTS=alitravel.uz,www.alitravel.uz
# The public address of the website (used in e-mails, sitemap.xml and robots.txt)
SITE_URL=https://alitravel.uz
CORS_ORIGINS=https://alitravel.uz,https://www.alitravel.uz
CSRF_TRUSTED_ORIGINS=https://alitravel.uz,https://www.alitravel.uz

# Reverse proxies in front of Django (1 with the nginx example). Needed so rate limits count each visitor separately.
NUM_PROXIES=1

# --- database (leave empty to keep using SQLite) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- e-mail: leave EMAIL_HOST empty to print e-mails in the console instead of sending them ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=ALI TRAVEL <alitravel004@gmail.com>

# --- who is told about new bookings, messages and reviews ---
NOTIFY_EMAILS=alitravel004@gmail.com
# Optional Telegram alerts: create a bot with @BotFather, send it a message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The Telegram account(s) that receive the alerts (they must press Start in the bot once). Nobody else is ever alerted.
TELEGRAM_TEAM_USERNAMES=Al1_travel
